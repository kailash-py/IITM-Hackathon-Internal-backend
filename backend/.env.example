# Copy this file to backend/.env and fill in values you have.
# The prototype runs without Twilio — alerts fall back to a simulator.

PORT=5000

# Optional: override the Python executable used for ML + A*
# PYTHON_PATH=C:\Users\you\Downloads\sih-hazard-system\sih-hazard-system\ai_model\venv\Scripts\python.exe

# Twilio SMS (optional). Create a trial account at https://console.twilio.com
# Use either AUTH_TOKEN or API_KEY + API_SECRET with ACCOUNT_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=
TEST_MOBILE_NUMBER=

# Optional: signs the desk-login session token (demo only)
AUTH_SECRET=sih-redzone-demo
